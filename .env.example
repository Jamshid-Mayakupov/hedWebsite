# Public canonical origin, without a trailing slash.
VITE_SITE_URL=https://example.com

# Use /hedWebsite/ for the GitHub project URL, or / for a custom domain.
VITE_BASE_PATH=/

# HTTPS backend origins, without trailing slashes.
VITE_API_BASE_URL=https://api.example.com
VITE_AUTH_API_BASE_URL=https://auth.example.com
VITE_FILE_API_BASE_URL=https://files.example.com

# Optional. The address list remains available when this is omitted.
VITE_YANDEX_MAPS_API_KEY=
